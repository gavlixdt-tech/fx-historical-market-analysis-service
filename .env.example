# ---------------------------------------------------------------------------
# fx-historical-market-analysis-service - environment template
#
# PLACEHOLDERS ONLY. Never commit real credentials. Copy to .env for local
# development; .env is git-ignored.
# ---------------------------------------------------------------------------

# ---- Service identity ----
SERVICE_NAME=fx-historical-market-analysis-service
SERVICE_VERSION=0.1.0
API_VERSION=v1
ENVIRONMENT=development
SERVICE_MODE=research-simulation

# ---- Runtime ----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Inbound security ----
# REQUIRE_AUTH must be true in production, and API_KEY must then be set.
REQUIRE_AUTH=false
API_KEY=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Request-ID,X-Correlation-ID,X-API-Key
TRUSTED_HOSTS=localhost,127.0.0.1,backend,testserver
DOCS_ENABLED_IN_PRODUCTION=false
MAX_REQUEST_BODY_BYTES=1048576

# ---- Upstream integration: fx-market-data-service ----
# Leave UPSTREAM_MARKET_DATA_BASE_URL empty to run without an upstream.
# On Railway, use the Service 1 private-network origin, including its port:
# http://fx-market-data-service.railway.internal:8000
# Production allows HTTP only for *.railway.internal with an explicit port;
# public production upstreams must use HTTPS.
UPSTREAM_MARKET_DATA_BASE_URL=
# Credential presented to Service 1 using X-API-Key. Server-side only.
# Must match Service 1 MARKET_DATA_CLIENT_API_KEYS_JSON['historical-analysis'].
# This is a dedicated Service 2 workload identity, not Service 1 API_KEY.
# Keep it server-side; never expose it to the browser.
UPSTREAM_API_KEY=
# Out-of-band Service 1 Ed25519 historical dataset trust bundle.
# JSON object: {"<Service 1 key_id>":"<base64 raw 32-byte public key>"}.
# Obtain the public key by running Service 1 scripts/export_historical_attestation_public_key.py
# in a trusted admin environment; never copy the private signing key.
UPSTREAM_HISTORICAL_ATTESTATION_PUBLIC_KEYS_JSON={}
# Production historical replay requires true and a non-empty trusted key bundle.
UPSTREAM_HISTORICAL_ATTESTATION_REQUIRED=false
UPSTREAM_TIMEOUT_SECONDS=5
UPSTREAM_CONNECT_TIMEOUT_SECONDS=5
UPSTREAM_READ_TIMEOUT_SECONDS=5
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_MAX_DURATION_SECONDS=10
UPSTREAM_MAX_CONCURRENT_REQUESTS=4
UPSTREAM_MAX_RESPONSE_BYTES=16777216
UPSTREAM_CONNECTIVITY_CHECK_ENABLED=true
UPSTREAM_MAX_HISTORY_LIMIT=5000
# Required for /historical-replay/run-from-market-data. Set a conservative,
# provider-specific delay; current Service 1 contract has no original publish time.
UPSTREAM_REPLAY_AVAILABILITY_DELAY_SECONDS=
# UPSTREAM_ALLOWED_HISTORY_START=2020-01-01T00:00:00Z
# UPSTREAM_ALLOWED_HISTORY_END=2030-01-01T00:00:00Z

# ---- GFX Admin Console replay settings ----
# Enable only after creating the dedicated Service 2 workload identity in
# Service 64 and registering it as a required consumer in the Admin Console.
# When enabled, the integration fails closed: no silent request-parameter fallback.
GFX_SETTINGS_ENABLED=false
GFX_SETTINGS_REQUIRED=false
# Admin Console BACKEND origin, not the browser/Vercel frontend URL.
# Prefer the Railway private-network origin with explicit service port.
GFX_SETTINGS_SERVICE_URL=
# Service 64 BACKEND origin; same private-network guidance as above.
FX_SECURITY_SERVICE_URL=
# Dedicated Service 2 workload identity from Service 64; server-side only.
GFX_SETTINGS_CLIENT_ID=
# Secret shown once by Service 64 when the identity is created; server-side only.
GFX_SETTINGS_CLIENT_SECRET=

# ---- Observability ----
OTEL_ENABLED=false
OTEL_ENDPOINT=
METRICS_ENABLED=true

# ---- Persistence (no durable artifact/database integration is implemented) ----
DATABASE_URL=


# ---- Service 62 signed lifecycle evidence consumer ----
# Disabled until the producer contract and source-attestation gates are accepted.
LIFECYCLE_EVENT_BUS_ENABLED=false
LIFECYCLE_EVENT_BUS_URL=
LIFECYCLE_EVENT_BUS_TOPIC=gfx.liquidity.lifecycle.v1
LIFECYCLE_EVENT_CONSUMER_GROUP=gfx-service2-lifecycle-evidence
LIFECYCLE_EVENT_BUS_CONSUMER_SECRET=
# JSON mapping Service 9 key IDs to base64 raw 32-byte Ed25519 public keys.
LIFECYCLE_EVENT_PUBLIC_KEYS_JSON={}
# Attach a Railway Volume at /data before enabling in production.
LIFECYCLE_EVENT_INBOX_DB_PATH=/data/lifecycle-inbox.sqlite3
LIFECYCLE_EVENT_POLL_INTERVAL_SECONDS=2
LIFECYCLE_EVENT_BATCH_SIZE=25
LIFECYCLE_EVENT_CLOCK_SKEW_SECONDS=60
