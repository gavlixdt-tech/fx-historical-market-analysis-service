# ---------------------------------------------------------------------------
# fx-historical-market-analysis-service - environment template
#
# PLACEHOLDERS ONLY. Never commit real credentials. Copy to .env for local
# development; .env is git-ignored.
# ---------------------------------------------------------------------------

# ---- Service identity ----
SERVICE_NAME=fx-historical-market-analysis-service
SERVICE_VERSION=0.1.0
API_VERSION=v1
ENVIRONMENT=development
SERVICE_MODE=research-simulation

# ---- Runtime ----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Inbound security ----
# REQUIRE_AUTH must be true in production, and API_KEY must then be set.
REQUIRE_AUTH=false
API_KEY=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Request-ID,X-Correlation-ID,X-API-Key
TRUSTED_HOSTS=localhost,127.0.0.1,backend,testserver
DOCS_ENABLED_IN_PRODUCTION=false
MAX_REQUEST_BODY_BYTES=1048576

# ---- Upstream integration: fx-market-data-service ----
# Leave UPSTREAM_MARKET_DATA_BASE_URL empty to run without an upstream.
# On Railway, use the Service 1 private-network origin, including its port:
# http://fx-market-data-service.railway.internal:8000
# Production allows HTTP only for *.railway.internal with an explicit port;
# public production upstreams must use HTTPS.
UPSTREAM_MARKET_DATA_BASE_URL=
# Credential presented to Service 1 using X-API-Key. Server-side only.
# Must match Service 1 API_KEY. When using the Gateway, configure the same
# secret as Gateway MARKET_DATA_API_KEY; never expose it to the browser.
UPSTREAM_API_KEY=
UPSTREAM_TIMEOUT_SECONDS=5
UPSTREAM_CONNECT_TIMEOUT_SECONDS=5
UPSTREAM_READ_TIMEOUT_SECONDS=5
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_MAX_DURATION_SECONDS=10
UPSTREAM_MAX_CONCURRENT_REQUESTS=4
UPSTREAM_MAX_RESPONSE_BYTES=16777216
UPSTREAM_CONNECTIVITY_CHECK_ENABLED=true
UPSTREAM_MAX_HISTORY_LIMIT=5000
# Required for /historical-replay/run-from-market-data. Set a conservative,
# provider-specific delay; current Service 1 contract has no original publish time.
UPSTREAM_REPLAY_AVAILABILITY_DELAY_SECONDS=
# UPSTREAM_ALLOWED_HISTORY_START=2020-01-01T00:00:00Z
# UPSTREAM_ALLOWED_HISTORY_END=2030-01-01T00:00:00Z

# ---- Observability ----
OTEL_ENABLED=false
OTEL_ENDPOINT=
METRICS_ENABLED=true

# ---- Persistence (no durable artifact/database integration is implemented) ----
DATABASE_URL=
