      "CapabilityStatus": {
        "description": "Status of a single capability.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Human-readable description",
            "title": "Detail"
          },
          "implemented": {
            "description": "Whether the capability is implemented",
            "title": "Implemented",
            "type": "boolean"
          },
